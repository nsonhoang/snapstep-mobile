{
  "expo": {
    "name": "SnapStep",
    "slug": "SnapStep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SnapStep sẽ sử dụng camera để chụp ảnh",
        "NSMicrophoneUsageDescription": "SnapStep sẽ sử dụng microphone để quay video"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.hoangshpy.SnapStep"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
       [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SnapStep to use your location."
        }
      ],
      "expo-font",
      "expo-image"
    ]
  }
}

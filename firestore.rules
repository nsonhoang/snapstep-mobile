rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. CÁC HÀM TRỢ GIÚP KIỂM TRA ĐIỀU KIỆN (HELPER FUNCTIONS)
    // =========================================================================

    // Kiểm tra: Người dùng đã đăng nhập Firebase Auth hay chưa?
    function daDangNhap() {
      return request.auth != null;
    }

    // Kiểm tra: Có phải chính chủ sở hữu tài khoản này không?
    function laChinhChu(userId) {
      return daDangNhap() && request.auth.uid == userId;
    }

    // Kiểm tra: Người xem có phải là bạn bè đã 'accepted' của tác giả không?
    // Tối ưu: Chỉ kiểm tra 1 chiều từ phía người xem vì hệ thống kết bạn lưu 2 chiều đối xứng (giảm 50% chi phí đọc)
    function laBanBe(tacGiaUid) {
      return daDangNhap() && (
        // Trường hợp 1: Tự mình xem bài viết/chuyến đi của chính mình
        request.auth.uid == tacGiaUid ||
        
        // Trường hợp 2: Kiểm tra trong danh bạ bạn bè của người xem
        (
          exists(/databases/$(database)/documents/friendships/$(request.auth.uid)/friends/$(tacGiaUid)) &&
          get(/databases/$(database)/documents/friendships/$(request.auth.uid)/friends/$(tacGiaUid)).data.status == 'accepted'
        )
      );
    }


    // =========================================================================
    // 2. BẢO MẬT COLLECTION "users" (HỒ SƠ CÁ NHÂN)
    // =========================================================================
    match /users/{userId} {
      // ĐỌC: Bất kỳ ai đã đăng nhập đều đọc được (để xem tên, avatar, tìm kiếm bạn bè)
      allow read: if daDangNhap();

      // TẠO & SỬA: Chỉ chính chủ userId mới được sửa thông tin cá nhân của mình
      allow create, update: if laChinhChu(userId);

      // XÓA: Cấm tuyệt đối xóa user trực tiếp từ app (chỉ admin mới có quyền)
      allow delete: if false;

      // -----------------------------------------------------------------------
      // 2.1 BẢO MẬT SUBCOLLECTION "chats" (HỘP THƯ TIN NHẮN HYBRID)
      // Đường dẫn: users/{userId}/chats/{chatId}
      // -----------------------------------------------------------------------
      match /chats/{chatId} {
        // ĐỌC: Chỉ chính chủ userId mới xem được hộp thư riêng tư của mình
        allow read: if laChinhChu(userId);

        // GHI: Cho phép chính chủ (khi đánh dấu đã đọc) HOẶC người gửi tin nhắn (khi cập nhật inbox người nhận)
        allow create, update: if daDangNhap() && (
          request.auth.uid == userId ||
          request.resource.data.lastSenderId == request.auth.uid
        );

        // XÓA: Chỉ chính chủ mới có quyền xóa hội thoại khỏi hộp thư của mình
        allow delete: if laChinhChu(userId);
      }

      // -----------------------------------------------------------------------
      // 2.2 BẢO MẬT SUBCOLLECTION "notifications" (HỘP THƯ THÔNG BÁO)
      // Đường dẫn: users/{userId}/notifications/{notificationId}
      // -----------------------------------------------------------------------
      match /notifications/{notificationId} {
        // ĐỌC, SỬA: Chỉ chính chủ userId mới có quyền xem hoặc đánh dấu đã đọc
        allow read, update: if laChinhChu(userId);

        // XÓA: Cho phép chính chủ userId HOẶC người gửi thông báo này (khi hủy kết bạn)
        allow delete: if daDangNhap() && (
          laChinhChu(userId) || 
          resource.data.senderId == request.auth.uid
        );

        // TẠO MỚI: Cho phép bất kỳ người dùng nào đã đăng nhập gửi thông báo đến userId này
        allow create: if daDangNhap();
      }
    }



    // =========================================================================
    // 3. BẢO MẬT COLLECTION "posts" (BÀI ĐĂNG & ẢNH CHECK-IN)
    // =========================================================================
    match /posts/{postId} {
      // ĐỌC: CHỈ TÁC GIẢ HOẶC BẠN BÈ ĐÃ KẾT BẠN MỚI ĐƯỢC XEM BÀI
      allow read: if laBanBe(resource.data.authorId);

      // TẠO MỚI: Bắt buộc người đăng bài phải gán authorId trùng khớp với UID của mình và bắt buộc phải có tripId hợp lệ
      allow create: if daDangNhap() && 
                    request.resource.data.authorId == request.auth.uid &&
                    'tripId' in request.resource.data &&
                    request.resource.data.tripId is string &&
                    request.resource.data.tripId.size() > 0;

      // CẬP NHẬT: 
      // - Hoặc chính tác giả sửa bài
      // - Hoặc bạn bè chỉ được phép cập nhật số lượng cảm xúc (like, love, hate, haha) và bắt buộc phải là số nguyên không âm
      allow update: if daDangNhap() && (
        laChinhChu(resource.data.authorId) ||
        (
          laBanBe(resource.data.authorId) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['like', 'love', 'hate', 'haha']) &&
          (!('like' in request.resource.data) || (request.resource.data.like is int && request.resource.data.like >= 0)) &&
          (!('love' in request.resource.data) || (request.resource.data.love is int && request.resource.data.love >= 0)) &&
          (!('hate' in request.resource.data) || (request.resource.data.hate is int && request.resource.data.hate >= 0)) &&
          (!('haha' in request.resource.data) || (request.resource.data.haha is int && request.resource.data.haha >= 0))
        )
      );

      // XÓA BÀI: Chỉ chính tác giả mới được xóa bài của mình
      allow delete: if laChinhChu(resource.data.authorId);
    }


    // =========================================================================
    // 4. BẢO MẬT COLLECTION "trips" (HÀNH TRÌNH CHUYẾN ĐI)
    // =========================================================================
    match /trips/{tripId} {
      // ĐỌC: CHỈ CHỦ CHUYẾN ĐI HOẶC BẠN BÈ MỚI ĐƯỢC XEM LỊCH TRÌNH
      allow read: if laBanBe(resource.data.userId);

      // TẠO MỚI: Phải gán đúng userId của chính mình
      allow create: if daDangNhap() && request.resource.data.userId == request.auth.uid;

      // SỬA & XÓA: Chỉ người tạo chuyến đi mới có quyền chỉnh sửa hoặc xóa
      allow update, delete: if laChinhChu(resource.data.userId);
    }


    // =========================================================================
    // 5. BẢO MẬT SUBCOLLECTION "friendships" (QUAN HỆ BẠN BÈ)
    // Đường dẫn: friendships/{userId}/friends/{friendId}
    // =========================================================================
    match /friendships/{userId}/friends/{friendId} {
      // ĐỌC: Chỉ chính chủ userId mới xem được danh sách bạn bè riêng tư của mình
      allow read: if laChinhChu(userId);

      // TẠO LỜI MỜI MỚI (CREATE):
      // Người gửi chỉ được tạo lời mời ở 2 trạng thái:
      // - Ghi vào kho của mình: phải là 'outgoing_pending'
      // - Ghi vào kho của người nhận: phải là 'incoming_pending'
      // CẤM TUYỆT ĐỐI việc tạo thẳng 'accepted'
      allow create: if daDangNhap() && (
        (request.auth.uid == userId && request.resource.data.status == 'outgoing_pending') ||
        (request.auth.uid == friendId && request.resource.data.status == 'incoming_pending')
      );

      // DUYỆT LỜI MỜI KẾT BẠN (UPDATE):
      // Khi nhấn Chấp nhận (acceptFriendRequest), chỉ người nhận lời mời mới có quyền kích hoạt chuyển sang 'accepted'
      allow update: if daDangNhap() && (
        (resource.data.status == 'incoming_pending' && request.auth.uid == userId && request.resource.data.status == 'accepted') ||
        (resource.data.status == 'outgoing_pending' && request.auth.uid == friendId && request.resource.data.status == 'accepted')
      );

      // HỦY LỜI MỜI / TỪ CHỐI / HỦY KẾT BẠN (DELETE):
      // Cả 2 người (người gửi hoặc người nhận) đều có quyền xóa mối quan hệ này
      allow delete: if daDangNhap() && (request.auth.uid == userId || request.auth.uid == friendId);
    }
  }
}
